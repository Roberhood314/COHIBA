{
  "name": "cohiba-meme-coin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080 --directory web",
    "typecheck": "tsc --noEmit",
    "token:create:devnet": "tsx scripts/create-token.ts --network devnet",
    "token:check:devnet": "tsx scripts/check-token.ts --network devnet",
    "token:create:local": "tsx scripts/create-token.ts --network localnet",
    "token:create:staged:devnet": "tsx scripts/create-token-staged.ts --network devnet",
    "token:revoke:devnet": "tsx scripts/revoke-authorities.ts --network devnet",
    "token:create:staged:mainnet": "tsx scripts/create-token-staged.ts --network mainnet-beta",
    "token:revoke:mainnet": "tsx scripts/revoke-authorities.ts --network mainnet-beta",
    "start": "node web-server.mjs",
    "build": "npm run verify:all && npm run evidence:generate && vite build",
    "token:auto-sweep:devnet": "tsx scripts/auto-sweep.ts --network devnet",
    "token:auto-sweep:mainnet": "tsx scripts/auto-sweep.ts --network mainnet-beta",
    "test": "node --test test/*.test.mjs",
    "verify:security": "node scripts/verify-security-posture.mjs",
    "evidence:generate": "node scripts/generate-security-evidence.mjs",
    "verify:all": "npm run test && npm run verify:security && npm run typecheck",
    "verify:ops": "node scripts/run-operational-drills.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.3.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.3.0",
    "bigint-buffer": "file:vendor/bigint-buffer-safe"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "@types/node": "^24.10.0",
    "vite": "^7.1.7"
  },
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=20 <25"
  },
  "overrides": {
    "bigint-buffer": "file:vendor/bigint-buffer-safe",
    "stream-json": "3.5.0",
    "uuid": "11.1.1"
  }
}
