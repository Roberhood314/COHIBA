SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# System treasury signer. Set ONLY as a Railway Secret, never commit a real value.
# SYSTEM_WALLET_SECRET_JSON=[...]
# Or local-only alternative:
SOLANA_WALLET_PATH=/absolute/path/to/system-wallet.json

COH_MINT=REPLACE_WITH_COH_MINT_ADDRESS
COH_DESTINATION_WALLET=pTEH7pYratL14VFPQ9i5JMvPYDCpCQ773cHQZ3DdW3t

AUTO_SWEEP_ENABLED=false

# Human-wallet checkout. Defaults off; no provider credentials in source.
HS_ACCOUNT_STORAGE=postgres
PI_APP_ENABLED=false
PI_APP_SANDBOX=true
ALLOW_PI_CHECKOUT=false
ALLOW_PI_MAINNET_CHECKOUT=false
ALLOW_OUSD_CHECKOUT=false
# INTEGRATION_PAYMENT_CATALOG=[{"sku":"your-service","label":"Your service","piAmount":"1.25","ousdAmount":"1.25"}]
# PI_SERVER_API_KEY=<Pi Developer Portal server secret>
# PI_APP_WALLET=<registered Pi app recipient for the selected network>
# OUSD_MERCHANT_WALLET=<merchant Solana wallet>
# OUSD_SOLANA_RPC_URL=<trusted Solana mainnet RPC, distinct from token-launch RPC>
# See docs/PI_OPEN_STANDARD_CHECKOUT.md for registration and recovery gates.

# Mainnet remains locked until explicitly approved:
# ALLOW_MAINNET=true

# Required in Railway before Mainnet launch. Use a strong random secret.
# COHIBA_MAINNET_LAUNCH_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
